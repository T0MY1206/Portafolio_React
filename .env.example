# EmailJS - Contact form (get these from https://dashboard.emailjs.com/)
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# App preferences (optional)
# Mascot: set to "false" to hide the mascot
VITE_MASCOT_ENABLED=true
# Default theme when user has no preference saved: "light" or "dark"
VITE_DEFAULT_THEME=dark

# Optional (for future use):
# VITE_GA_MEASUREMENT_ID=G-XXXX   # Google Analytics 4
# VITE_SITE_URL=https://...       # Full site URL for meta/social
